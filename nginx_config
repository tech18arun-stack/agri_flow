server {
    listen 80;
    server_name farmer.websitescorp.com;

    # Redirect all HTTP traffic to HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name farmer.websitescorp.com;

    root /home/server/My_Sites/agriflow;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/farmer.websitescorp.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/farmer.websitescorp.com/privkey.pem;

    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Important for Flutter Web SPAs - handles client-side routing
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy API requests to Appwrite
    location ^~ /v1 {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Optional: Enable Gzip for faster loading
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
}
